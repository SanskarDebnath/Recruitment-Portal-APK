<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vStepIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorPrimary"/>

        <View
            android:id="@+id/vTimelineConnector"
            android:layout_width="2dp"
            android:layout_height="50dp"
            android:background="#E2E8F0"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvMilestoneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application Submitted"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvMilestoneDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 May 2026, 10:30 AM"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvMilestoneDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your application has been received and is currently under review by the HR department."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</LinearLayout>