<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Orange Theme (Before Login) -->
    <style name="Theme.RecruitmentPortal" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimaryContainer">#FFEDD5</item>
        <item name="colorOnPrimaryContainer">@color/primary_orange</item>
    </style>

    <!-- Green Theme (After Login) -->
    <style name="Theme.RecruitmentPortal.Dashboard" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimaryContainer">#D1FAE5</item>
        <item name="colorOnPrimaryContainer">@color/primary_green</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#80000000</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorPrimary">@color/primary_orange</item>
    </style>

    <!-- Transparent Green Theme for Dashboard Overlays -->
    <style name="Theme.Transparent.Dashboard" parent="Theme.Transparent">
        <item name="colorPrimary">@color/primary_green</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>